{
	"appId": "com.hostelfriend.app",
	"appName": "Hostel Friend",
	"webDir": "dist",
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 3000,
			"launchAutoHide": false,
			"launchFadeOutDuration": 200,
			"backgroundColor": "#050505",
			"showSpinner": false
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"google.com"
			]
		},
		"FirebaseMessaging": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
