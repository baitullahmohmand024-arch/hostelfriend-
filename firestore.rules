rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number is string && request.auth.token.phone_number.size() > 0)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          'email' in request.auth.token &&
          request.auth.token.email == 'baitullahmohmand024@gmail.com'
        )
      );
    }

    function isNotSuspended() {
      return isVerified() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuspended == false
      );
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'username', 'usernameLower', 'fullName', 'bio', 'hostel',
        'avatarUrl', 'coverUrl', 'followersCount', 'followingCount', 'postsCount',
        'isSuspended', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'username', 'usernameLower', 'fullName', 'bio', 'hostel',
        'avatarUrl', 'coverUrl', 'followersCount', 'followingCount', 'postsCount',
        'isSuspended', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.username is string && data.username.size() >= 3 && data.username.size() <= 24 && data.username.matches('^[a-zA-Z0-9_]+$')
      && data.usernameLower is string && data.usernameLower.size() >= 3 && data.usernameLower.size() <= 24 && data.usernameLower.matches('^[a-z0-9_]+$')
      && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 64
      && data.bio is string && data.bio.size() <= 240
      && data.hostel is string && data.hostel.size() <= 80
      && data.avatarUrl is string && data.avatarUrl.size() <= 32768
      && data.coverUrl is string && data.coverUrl.size() <= 250000
      && data.followersCount is int && data.followersCount >= 0
      && data.followingCount is int && data.followingCount >= 0
      && data.postsCount is int && data.postsCount >= 0
      && data.isSuspended is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidStory(data) {
      return data.keys().hasAll([
        'id', 'authorId', 'authorUsername', 'authorName', 'authorAvatarUrl',
        'mediaUrl', 'mediaType', 'caption', 'visibility', 'createdAt', 'expiresAt'
      ])
      && data.keys().hasOnly([
        'id', 'authorId', 'authorUsername', 'authorName', 'authorAvatarUrl',
        'mediaUrl', 'mediaType', 'caption', 'visibility', 'likesCount', 'createdAt', 'expiresAt'
      ])
      && isValidId(data.id)
      && isValidId(data.authorId)
      && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 24 && data.authorUsername.matches('^[a-zA-Z0-9_]+$')
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64
      && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 32768
      && data.mediaUrl is string && data.mediaUrl.size() <= 500000
      && (
        (data.mediaUrl.size() >= 9 && data.mediaUrl[0:8] == 'https://') ||
        (data.mediaUrl.size() >= 13 && data.mediaUrl.size() <= 260 && data.mediaUrl[0:11] == '/api/media/' && data.mediaUrl.matches('^/api/media/[a-zA-Z0-9._\\-]+$')) ||
        (data.mediaUrl.size() >= 24 && data.mediaUrl[0:23].matches('^data:image/(webp|jpeg|png|gif);base64,.*')) ||
        (data.mediaUrl.size() >= 30 && data.mediaUrl[0:11] == 'data:video/' && data.mediaUrl[0:30].matches('^data:video/(mp4|webm|quicktime);base64,.*'))
      )
      && data.mediaType in ['image', 'video']
      && data.caption is string && data.caption.size() <= 280
      && data.visibility == 'public'
      && (!('likesCount' in data) || (data.likesCount is int && data.likesCount >= 0))
      && data.createdAt is timestamp
      && data.expiresAt is timestamp;
    }

    function isValidStoryLike(data) {
      return data.keys().hasAll([
        'id', 'storyId', 'storyAuthorId', 'userId', 'userUsername', 'userName', 'userAvatarUrl', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'storyId', 'storyAuthorId', 'userId', 'userUsername', 'userName', 'userAvatarUrl', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.storyId)
      && isValidId(data.storyAuthorId)
      && isValidId(data.userId)
      && data.userUsername is string && data.userUsername.size() <= 24
      && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 64
      && data.userAvatarUrl is string && data.userAvatarUrl.size() <= 32768
      && data.createdAt is timestamp;
    }

    function isValidPoll(data) {
      return data.keys().hasAll([
        'id', 'authorId', 'authorUsername', 'authorName', 'authorAvatarUrl',
        'question', 'options', 'count0', 'count1', 'count2', 'count3', 'count4', 'count5',
        'totalVotes', 'visibility', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'authorId', 'authorUsername', 'authorName', 'authorAvatarUrl',
        'question', 'options', 'count0', 'count1', 'count2', 'count3', 'count4', 'count5',
        'totalVotes', 'visibility', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.authorId)
      && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 24 && data.authorUsername.matches('^[a-zA-Z0-9_]+$')
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64
      && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 32768
      && data.question is string && data.question.size() >= 3 && data.question.size() <= 280
      && data.options is list && data.options.size() >= 2 && data.options.size() <= 6
      && data.options[0] is string && data.options[0].size() >= 1 && data.options[0].size() <= 80
      && data.options[1] is string && data.options[1].size() >= 1 && data.options[1].size() <= 80
      && (data.options.size() < 3 || (data.options[2] is string && data.options[2].size() >= 1 && data.options[2].size() <= 80))
      && (data.options.size() < 4 || (data.options[3] is string && data.options[3].size() >= 1 && data.options[3].size() <= 80))
      && (data.options.size() < 5 || (data.options[4] is string && data.options[4].size() >= 1 && data.options[4].size() <= 80))
      && (data.options.size() < 6 || (data.options[5] is string && data.options[5].size() >= 1 && data.options[5].size() <= 80))
      && data.count0 is int && data.count0 >= 0
      && data.count1 is int && data.count1 >= 0
      && data.count2 is int && data.count2 >= 0
      && data.count3 is int && data.count3 >= 0
      && data.count4 is int && data.count4 >= 0
      && data.count5 is int && data.count5 >= 0
      && data.totalVotes is int && data.totalVotes >= 0
      && data.visibility == 'public'
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPollVote(data) {
      return data.keys().hasAll(['id', 'pollId', 'userId', 'optionIndex', 'createdAt'])
      && data.keys().hasOnly(['id', 'pollId', 'userId', 'optionIndex', 'createdAt'])
      && isValidId(data.id)
      && isValidId(data.pollId)
      && isValidId(data.userId)
      && data.optionIndex is int && data.optionIndex >= 0 && data.optionIndex <= 5
      && data.createdAt is timestamp;
    }

    function isSinglePollOptionIncremented(idx) {
      return idx is int
        && idx >= 0
        && idx < existing().options.size()
        && incoming().totalVotes == existing().totalVotes + 1
        && (idx == 0 ? incoming().count0 == existing().count0 + 1 : incoming().count0 == existing().count0)
        && (idx == 1 ? incoming().count1 == existing().count1 + 1 : incoming().count1 == existing().count1)
        && (idx == 2 ? incoming().count2 == existing().count2 + 1 : incoming().count2 == existing().count2)
        && (idx == 3 ? incoming().count3 == existing().count3 + 1 : incoming().count3 == existing().count3)
        && (idx == 4 ? incoming().count4 == existing().count4 + 1 : incoming().count4 == existing().count4)
        && (idx == 5 ? incoming().count5 == existing().count5 + 1 : incoming().count5 == existing().count5);
    }

    function isValidUserPrivateSettings(data) {
      return data.keys().hasAll([
        'uid', 'email', 'privacyMode', 'notifyLikes', 'notifyComments',
        'notifyFollows', 'notifyMessages', 'blockedUserIds', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'privacyMode', 'notifyLikes', 'notifyComments',
        'notifyFollows', 'notifyMessages', 'blockedUserIds', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.email is string && data.email.size() <= 254
      && data.privacyMode in ['public', 'followers']
      && data.notifyLikes is bool
      && data.notifyComments is bool
      && data.notifyFollows is bool
      && data.notifyMessages is bool
      && data.blockedUserIds is list && data.blockedUserIds.size() <= 100
      && (data.blockedUserIds.size() == 0 || data.blockedUserIds[0] is string)
      && data.updatedAt is timestamp;
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
      && data.keys().hasOnly(['uid', 'createdAt'])
      && isValidId(data.uid)
      && data.createdAt is timestamp;
    }

    function isValidReactionType(t) {
      return t in ['like', 'love', 'haha', 'wow', 'sad', 'care'];
    }

    function isValidReactionCounts(rc) {
      return rc is map
        && rc.keys().hasOnly(['like', 'love', 'haha', 'wow', 'sad', 'care'])
        && (!('like' in rc) || (rc.like is int && rc.like >= 0))
        && (!('love' in rc) || (rc.love is int && rc.love >= 0))
        && (!('haha' in rc) || (rc.haha is int && rc.haha >= 0))
        && (!('wow' in rc) || (rc.wow is int && rc.wow >= 0))
        && (!('sad' in rc) || (rc.sad is int && rc.sad >= 0))
        && (!('care' in rc) || (rc.care is int && rc.care >= 0));
    }

    function reactionCountsTotal(rc) {
      return rc.get('like', 0)
        + rc.get('love', 0)
        + rc.get('haha', 0)
        + rc.get('wow', 0)
        + rc.get('sad', 0)
        + rc.get('care', 0);
    }

    function isValidPost(data) {
      return data.keys().hasAll([
        'id', 'authorId', 'authorUsername', 'authorName', 'authorAvatarUrl',
        'mediaUrl', 'mediaType', 'aspectRatio', 'caption', 'hashtags',
        'visibility', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'authorId', 'authorUsername', 'authorName', 'authorAvatarUrl',
        'mediaUrl', 'thumbnailUrl', 'mediaType', 'aspectRatio', 'caption', 'hashtags',
        'visibility', 'likesCount', 'reactionCounts', 'commentsCount', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.authorId)
      && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 24 && data.authorUsername.matches('^[a-zA-Z0-9_]+$')
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64
      && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 32768
      && data.mediaUrl is string && data.mediaUrl.size() <= 500000
      && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 100000))
      && data.mediaType in ['image', 'video', 'text']
      && data.aspectRatio in ['square', 'landscape', 'portrait', 'vertical']
      && data.caption is string && data.caption.size() <= 1000
      && (
        (data.mediaType == 'text' && data.mediaUrl.size() == 0 && data.caption.size() >= 1) ||
        (data.mediaType in ['image', 'video'] && (
          (data.mediaUrl.size() >= 9 && data.mediaUrl[0:8] == 'https://') ||
          (data.mediaUrl.size() >= 13 && data.mediaUrl.size() <= 260 && data.mediaUrl[0:11] == '/api/media/' && data.mediaUrl.matches('^/api/media/[a-zA-Z0-9._\\-]+$')) ||
          (data.mediaUrl.size() >= 24 && data.mediaUrl[0:23].matches('^data:image/(webp|jpeg|png|gif);base64,.*')) ||
          (data.mediaUrl.size() >= 30 && data.mediaUrl[0:11] == 'data:video/' && data.mediaUrl[0:30].matches('^data:video/(mp4|webm|quicktime);base64,.*'))
        ))
      )
      && data.hashtags is list && data.hashtags.size() <= 10
      && (data.hashtags.size() == 0 || data.hashtags[0] is string)
      && data.visibility == 'public'
      && data.likesCount is int && data.likesCount >= 0
      && (!('reactionCounts' in data) || isValidReactionCounts(data.reactionCounts))
      && data.commentsCount is int && data.commentsCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll([
        'id', 'postId', 'postAuthorId', 'authorId', 'authorUsername',
        'authorName', 'authorAvatarUrl', 'text', 'isPublic', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'postId', 'postAuthorId', 'authorId', 'authorUsername',
        'authorName', 'authorAvatarUrl', 'text', 'parentCommentId',
        'replyToUserId', 'replyToUsername', 'isPublic', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.postId)
      && isValidId(data.postAuthorId)
      && isValidId(data.authorId)
      && data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 24 && data.authorUsername.matches('^[a-zA-Z0-9_]+$')
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64
      && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 32768
      && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
      && (!('parentCommentId' in data) || (data.parentCommentId is string && data.parentCommentId.size() <= 128))
      && (!('replyToUserId' in data) || (data.replyToUserId is string && data.replyToUserId.size() <= 128))
      && (!('replyToUsername' in data) || (data.replyToUsername is string && data.replyToUsername.size() <= 24))
      && data.isPublic is bool
      && data.createdAt is timestamp;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['id', 'postId', 'userId', 'createdAt'])
      && data.keys().hasOnly([
        'id', 'postId', 'userId', 'reactionType',
        'userUsername', 'userName', 'userAvatarUrl', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.postId)
      && isValidId(data.userId)
      && (!('reactionType' in data) || isValidReactionType(data.reactionType))
      && (!('userUsername' in data) || (data.userUsername is string && data.userUsername.size() <= 24))
      && (!('userName' in data) || (data.userName is string && data.userName.size() <= 64))
      && (!('userAvatarUrl' in data) || (data.userAvatarUrl is string && data.userAvatarUrl.size() <= 32768))
      && data.createdAt is timestamp
      && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidFollow(data) {
      return data.keys().hasAll(['id', 'followerId', 'followingId', 'createdAt'])
      && data.keys().hasOnly(['id', 'followerId', 'followingId', 'createdAt'])
      && isValidId(data.id)
      && isValidId(data.followerId)
      && isValidId(data.followingId)
      && data.followerId != data.followingId
      && data.createdAt is timestamp;
    }

    function isValidSavedPost(data) {
      return data.keys().hasAll(['id', 'userId', 'postId', 'createdAt'])
      && data.keys().hasOnly(['id', 'userId', 'postId', 'createdAt'])
      && isValidId(data.id)
      && isValidId(data.userId)
      && isValidId(data.postId)
      && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
        'id', 'recipientId', 'actorId', 'actorUsername', 'actorName',
        'actorAvatarUrl', 'type', 'postId', 'message', 'isRead', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'recipientId', 'actorId', 'senderId', 'actorUsername', 'actorName',
        'actorAvatarUrl', 'type', 'title', 'body', 'postId', 'relatedPostId',
        'relatedCommentId', 'relatedConversationId', 'relatedMessageId',
        'relatedRequestId', 'actionUrl', 'message', 'isRead', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.recipientId)
      && isValidId(data.actorId)
      && (!('senderId' in data) || (data.senderId is string && data.senderId.size() <= 128))
      && data.actorUsername is string && data.actorUsername.size() <= 24
      && data.actorName is string && data.actorName.size() <= 64
      && data.actorAvatarUrl is string && data.actorAvatarUrl.size() <= 32768
      && data.type in [
        'NEW_MESSAGE', 'POST_LIKE', 'POST_COMMENT', 'COMMENT_REPLY',
        'NEW_FOLLOWER', 'FRIEND_REQUEST', 'FRIEND_REQUEST_ACCEPTED',
        'USER_MENTION', 'IMPORTANT_APP_ANNOUNCEMENT',
        'like', 'comment', 'follow', 'mention', 'system'
      ]
      && (!('title' in data) || (data.title is string && data.title.size() <= 120))
      && (!('body' in data) || (data.body is string && data.body.size() <= 280))
      && data.postId is string && data.postId.size() <= 128
      && (!('relatedPostId' in data) || (data.relatedPostId is string && data.relatedPostId.size() <= 128))
      && (!('relatedCommentId' in data) || (data.relatedCommentId is string && data.relatedCommentId.size() <= 128))
      && (!('relatedConversationId' in data) || (data.relatedConversationId is string && data.relatedConversationId.size() <= 128))
      && (!('relatedMessageId' in data) || (data.relatedMessageId is string && data.relatedMessageId.size() <= 128))
      && (!('relatedRequestId' in data) || (data.relatedRequestId is string && data.relatedRequestId.size() <= 128))
      && (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 256))
      && data.message is string && data.message.size() >= 1 && data.message.size() <= 280
      && data.isRead is bool
      && data.createdAt is timestamp;
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll([
        'id', 'senderId', 'senderUsername', 'senderName', 'senderAvatarUrl',
        'recipientId', 'recipientUsername', 'recipientName', 'recipientAvatarUrl',
        'participantIds', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'senderId', 'senderUsername', 'senderName', 'senderAvatarUrl',
        'recipientId', 'recipientUsername', 'recipientName', 'recipientAvatarUrl',
        'participantIds', 'status', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.senderId)
      && isValidId(data.recipientId)
      && data.senderId != data.recipientId
      && data.senderUsername is string && data.senderUsername.size() <= 24
      && data.senderName is string && data.senderName.size() <= 64
      && data.senderAvatarUrl is string && data.senderAvatarUrl.size() <= 32768
      && data.recipientUsername is string && data.recipientUsername.size() <= 24
      && data.recipientName is string && data.recipientName.size() <= 64
      && data.recipientAvatarUrl is string && data.recipientAvatarUrl.size() <= 32768
      && data.participantIds is list && data.participantIds.size() == 2
      && data.senderId in data.participantIds
      && data.recipientId in data.participantIds
      && data.status in ['pending', 'accepted', 'declined']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidNotificationPreferences(data) {
      return data.keys().hasAll([
        'uid', 'messages', 'likes', 'comments', 'commentReplies',
        'follows', 'friendRequests', 'mentions', 'announcements',
        'pushEnabled', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'messages', 'likes', 'comments', 'commentReplies',
        'follows', 'friendRequests', 'mentions', 'announcements',
        'pushEnabled', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.messages is bool
      && data.likes is bool
      && data.comments is bool
      && data.commentReplies is bool
      && data.follows is bool
      && data.friendRequests is bool
      && data.mentions is bool
      && data.announcements is bool
      && data.pushEnabled is bool
      && data.updatedAt is timestamp;
    }

    function isValidFcmToken(data) {
      return data.keys().hasAll([
        'id', 'uid', 'token', 'platform', 'userAgent', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'uid', 'token', 'platform', 'userAgent', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.uid)
      && data.token is string && data.token.size() >= 10 && data.token.size() <= 512
      && data.platform in ['web', 'android-pwa', 'ios-pwa']
      && data.userAgent is string && data.userAgent.size() <= 300
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
        'id', 'participantIds', 'participantAId', 'participantBId',
        'participantAUsername', 'participantAName', 'participantAAvatar',
        'participantBUsername', 'participantBName', 'participantBAvatar',
        'lastMessageText', 'lastMessageSenderId', 'unreadByA', 'unreadByB',
        'lastMessageAt', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'participantIds', 'participantAId', 'participantBId',
        'participantAUsername', 'participantAName', 'participantAAvatar',
        'participantBUsername', 'participantBName', 'participantBAvatar',
        'lastMessageText', 'lastMessageSenderId', 'unreadByA', 'unreadByB',
        'typingAAt', 'typingBAt', 'lastMessageAt', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.participantIds is list && data.participantIds.size() == 2
      && data.participantIds[0] is string && data.participantIds[1] is string
      && isValidId(data.participantAId)
      && isValidId(data.participantBId)
      && data.participantAId != data.participantBId
      && data.participantAId in data.participantIds
      && data.participantBId in data.participantIds
      && data.participantAUsername is string && data.participantAUsername.size() <= 24
      && data.participantAName is string && data.participantAName.size() <= 64
      && data.participantAAvatar is string && data.participantAAvatar.size() <= 32768
      && data.participantBUsername is string && data.participantBUsername.size() <= 24
      && data.participantBName is string && data.participantBName.size() <= 64
      && data.participantBAvatar is string && data.participantBAvatar.size() <= 32768
      && data.lastMessageText is string && data.lastMessageText.size() <= 500
      && data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128
      && data.unreadByA is int && data.unreadByA >= 0
      && data.unreadByB is int && data.unreadByB >= 0
      && (!('typingAAt' in data) || data.typingAAt == null || data.typingAAt is timestamp)
      && (!('typingBAt' in data) || data.typingBAt == null || data.typingBAt is timestamp)
      && data.lastMessageAt is timestamp
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
        'id', 'conversationId', 'participantIds', 'senderId',
        'recipientId', 'text', 'isRead', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'conversationId', 'participantIds', 'senderId',
        'recipientId', 'text', 'isRead', 'readAt', 'createdAt'
      ])
      && isValidId(data.id)
      && isValidId(data.conversationId)
      && data.participantIds is list && data.participantIds.size() == 2
      && data.participantIds[0] is string && data.participantIds[1] is string
      && isValidId(data.senderId)
      && isValidId(data.recipientId)
      && data.senderId in data.participantIds
      && data.recipientId in data.participantIds
      && data.senderId != data.recipientId
      && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
      && data.isRead is bool
      && (!('readAt' in data) || data.readAt is timestamp)
      && data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll([
        'id', 'reporterId', 'targetType', 'targetId', 'targetAuthorId',
        'reason', 'details', 'status', 'reviewedBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'reporterId', 'targetType', 'targetId', 'targetAuthorId',
        'reason', 'details', 'status', 'reviewedBy', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.reporterId)
      && data.targetType in ['post', 'user', 'comment']
      && isValidId(data.targetId)
      && data.targetAuthorId is string && data.targetAuthorId.size() <= 128
      && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 100
      && data.details is string && data.details.size() <= 600
      && data.status in ['open', 'resolved', 'dismissed']
      && data.reviewedBy is string && data.reviewedBy.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll([
        'maxUploadSizeMB', 'allowNewRegistrations', 'maintenanceNotice',
        'featuredHashtags', 'updatedBy', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'maxUploadSizeMB', 'allowNewRegistrations', 'maintenanceNotice',
        'featuredHashtags', 'updatedBy', 'updatedAt'
      ])
      && data.maxUploadSizeMB is int && data.maxUploadSizeMB >= 1 && data.maxUploadSizeMB <= 100
      && data.allowNewRegistrations is bool
      && data.maintenanceNotice is string && data.maintenanceNotice.size() <= 240
      && data.featuredHashtags is list && data.featuredHashtags.size() <= 10
      && (data.featuredHashtags.size() == 0 || data.featuredHashtags[0] is string)
      && isValidId(data.updatedBy)
      && data.updatedAt is timestamp;
    }

    // 4. Collection Match Rules

    // Public Profiles (/users/{userId}) - zero PII stored here
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || resource == null || existing().uid == userId);
      allow list: if (request.query.limit is int && request.query.limit <= 100) || isAdmin();

      allow create: if isVerified()
                    && isValidId(userId)
                    && isValidUserProfile(incoming())
                    && isOwner(userId)
                    && incoming().uid == userId
                    && incoming().followersCount == 0
                    && incoming().followingCount == 0
                    && incoming().postsCount == 0
                    && incoming().isSuspended == false
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isVerified()
                    && isValidId(userId)
                    && isValidUserProfile(incoming())
                    && incoming().uid == existing().uid
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      isAdmin() ||
                      // Action 1: Owner edits their own profile fields
                      (
                        isOwner(userId)
                        && existing().isSuspended == false
                        && incoming().isSuspended == existing().isSuspended
                        && incoming().followersCount == existing().followersCount
                        && incoming().followingCount == existing().followingCount
                        && incoming().postsCount == existing().postsCount
                        && incoming().diff(existing()).affectedKeys().hasOnly([
                          'username', 'usernameLower', 'fullName', 'bio', 'hostel',
                          'avatarUrl', 'coverUrl', 'updatedAt'
                        ])
                      ) ||
                      // Action 2: Owner updates own postsCount atomically when creating/deleting a post
                      (
                        isOwner(userId)
                        && existing().isSuspended == false
                        && incoming().diff(existing()).affectedKeys().hasOnly(['postsCount', 'updatedAt'])
                        && (incoming().postsCount == existing().postsCount + 1 || incoming().postsCount == existing().postsCount - 1)
                      ) ||
                      // Action 3: Owner updates own followingCount atomically with /follows/{myUid}_{targetUid}
                      (
                        isOwner(userId)
                        && existing().isSuspended == false
                        && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt'])
                        && (incoming().followingCount == existing().followingCount + 1 || incoming().followingCount == existing().followingCount - 1)
                      ) ||
                      // Action 4: Another user updates target user's followersCount atomically with /follows/{myUid}_{userId}
                      (
                        isNotSuspended()
                        && request.auth.uid != userId
                        && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
                        && (
                          (
                            incoming().followersCount == existing().followersCount + 1
                            && !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
                            && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
                          ) ||
                          (
                            incoming().followersCount == existing().followersCount - 1
                            && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
                            && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
                          )
                        )
                      )
                    );

      allow delete: if isVerified() && (isOwner(userId) || isAdmin()) && isValidId(userId);

      // Isolated Private Settings & PII (/users/{userId}/private/settings)
      match /private/settings {
        allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isVerified()
                      && isValidId(userId)
                      && isOwner(userId)
                      && isValidUserPrivateSettings(incoming())
                      && incoming().uid == userId
                      && incoming().updatedAt == request.time;
        allow update: if isVerified()
                      && isValidId(userId)
                      && (isOwner(userId) || isAdmin())
                      && isValidUserPrivateSettings(incoming())
                      && incoming().uid == existing().uid
                      && incoming().updatedAt == request.time
                      && incoming().diff(existing()).affectedKeys().hasOnly([
                        'email', 'privacyMode', 'notifyLikes', 'notifyComments',
                        'notifyFollows', 'notifyMessages', 'blockedUserIds', 'updatedAt'
                      ]);
        allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      }

      // Granular Notification Preferences (/users/{userId}/notificationSettings/preferences)
      match /notificationSettings/preferences {
        allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isVerified()
                      && isValidId(userId)
                      && isOwner(userId)
                      && isValidNotificationPreferences(incoming())
                      && incoming().uid == userId
                      && incoming().updatedAt == request.time;
        allow update: if isVerified()
                      && isValidId(userId)
                      && isOwner(userId)
                      && isValidNotificationPreferences(incoming())
                      && incoming().uid == existing().uid
                      && incoming().updatedAt == request.time;
        allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
      }

      // Private Device FCM Push Tokens (/users/{userId}/fcmTokens/{tokenId})
      match /fcmTokens/{tokenId} {
        allow get, list: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isVerified()
                      && isValidId(userId)
                      && isValidId(tokenId)
                      && isOwner(userId)
                      && isValidFcmToken(incoming())
                      && incoming().id == tokenId
                      && incoming().uid == userId
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
        allow update: if isVerified()
                      && isValidId(userId)
                      && isValidId(tokenId)
                      && isOwner(userId)
                      && isValidFcmToken(incoming())
                      && incoming().id == existing().id
                      && incoming().uid == existing().uid
                      && incoming().createdAt == existing().createdAt
                      && incoming().updatedAt == request.time;
        allow delete: if isSignedIn()
                      && isValidId(userId)
                      && isValidId(tokenId)
                      && (isOwner(userId) || isAdmin());
      }
    }

    // Username Reservation Index (/usernames/{usernameLower})
    match /usernames/{usernameLower} {
      allow get: if isValidId(usernameLower);
      allow create: if isVerified()
                    && isValidId(usernameLower)
                    && isValidUsernameReservation(incoming())
                    && incoming().uid == request.auth.uid
                    && incoming().createdAt == request.time
                    && !exists(/databases/$(database)/documents/usernames/$(usernameLower));
      allow delete: if isVerified()
                    && isValidId(usernameLower)
                    && (existing().uid == request.auth.uid || isAdmin());
    }

    // Posts (/posts/{postId})
    match /posts/{postId} {
      allow get: if isValidId(postId) && (resource == null || existing().visibility == 'public');
      allow list: if (request.query.limit is int && request.query.limit <= 100) || isAdmin();

      allow create: if isNotSuspended()
                    && isValidId(postId)
                    && isValidPost(incoming())
                    && incoming().id == postId
                    && incoming().authorId == request.auth.uid
                    && incoming().likesCount == 0
                    && incoming().commentsCount == 0
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerified()
                    && isValidId(postId)
                    && isValidPost(incoming())
                    && incoming().id == existing().id
                    && incoming().authorId == existing().authorId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      isAdmin() ||
                      // Action 1: Author updates caption or hashtags
                      (
                        isOwner(existing().authorId)
                        && isNotSuspended()
                        && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'hashtags', 'updatedAt'])
                      ) ||
                      // Action 2: Atomic React / Switch Reaction / Unreact counter update paired with /likes/{postId}_{uid}
                      (
                        isNotSuspended()
                        && (!('reactionCounts' in incoming()) || reactionCountsTotal(incoming().reactionCounts) == incoming().likesCount)
                        && (
                          (
                            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'reactionCounts', 'updatedAt'])
                            && incoming().likesCount == existing().likesCount + 1
                            && !exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
                            && existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
                          ) ||
                          (
                            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'reactionCounts', 'updatedAt'])
                            && existing().likesCount >= 1
                            && incoming().likesCount == existing().likesCount - 1
                            && exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
                            && !existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
                          ) ||
                          (
                            incoming().diff(existing()).affectedKeys().hasOnly(['reactionCounts', 'updatedAt'])
                            && incoming().likesCount == existing().likesCount
                            && exists(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
                            && existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid))
                            && getAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid)).data.reactionType
                               != get(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid)).data.get('reactionType', 'like')
                          )
                        )
                      ) ||
                      // Action 3: Comment counter increment/decrement
                      (
                        isNotSuspended()
                        && incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt'])
                        && (
                          incoming().commentsCount == existing().commentsCount + 1 ||
                          incoming().commentsCount == existing().commentsCount - 1
                        )
                      )
                    );

      allow delete: if isVerified()
                    && isValidId(postId)
                    && (isOwner(existing().authorId) || isAdmin());
    }

    // Stories (/stories/{storyId})
    match /stories/{storyId} {
      allow get: if isValidId(storyId) && (resource == null || existing().visibility == 'public');
      allow list: if (request.query.limit is int && request.query.limit <= 50) || isAdmin();

      allow create: if isNotSuspended()
                    && isValidId(storyId)
                    && isValidStory(incoming())
                    && incoming().id == storyId
                    && incoming().authorId == request.auth.uid
                    && (!('likesCount' in incoming()) || incoming().likesCount == 0)
                    && incoming().createdAt == request.time
                    && incoming().expiresAt > request.time
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isNotSuspended()
                    && isValidId(storyId)
                    && isValidStory(incoming())
                    && incoming().id == existing().id
                    && incoming().authorId == existing().authorId
                    && incoming().authorUsername == existing().authorUsername
                    && incoming().authorName == existing().authorName
                    && incoming().authorAvatarUrl == existing().authorAvatarUrl
                    && incoming().mediaUrl == existing().mediaUrl
                    && incoming().mediaType == existing().mediaType
                    && incoming().caption == existing().caption
                    && incoming().visibility == existing().visibility
                    && incoming().createdAt == existing().createdAt
                    && incoming().expiresAt == existing().expiresAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
                    && (
                      (
                        (
                          (!('likesCount' in existing()) && incoming().likesCount == 1) ||
                          (('likesCount' in existing()) && incoming().likesCount == existing().likesCount + 1)
                        )
                        && !exists(/databases/$(database)/documents/storyLikes/$(storyId + '_' + request.auth.uid))
                        && existsAfter(/databases/$(database)/documents/storyLikes/$(storyId + '_' + request.auth.uid))
                      ) ||
                      (
                        ('likesCount' in existing())
                        && existing().likesCount >= 1
                        && incoming().likesCount == existing().likesCount - 1
                        && exists(/databases/$(database)/documents/storyLikes/$(storyId + '_' + request.auth.uid))
                        && !existsAfter(/databases/$(database)/documents/storyLikes/$(storyId + '_' + request.auth.uid))
                      )
                    );

      allow delete: if isVerified()
                    && isValidId(storyId)
                    && (isOwner(existing().authorId) || isAdmin());
    }

    // Story Likes (/storyLikes/{storyLikeId})
    match /storyLikes/{storyLikeId} {
      allow get: if isSignedIn()
                 && isValidId(storyLikeId)
                 && (resource == null || existing().userId == request.auth.uid || existing().storyAuthorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || resource.data.storyAuthorId == request.auth.uid || isAdmin());

      allow create: if isNotSuspended()
                    && isValidId(storyLikeId)
                    && isValidStoryLike(incoming())
                    && incoming().id == storyLikeId
                    && incoming().userId == request.auth.uid
                    && storyLikeId == (incoming().storyId + '_' + request.auth.uid)
                    && exists(/databases/$(database)/documents/stories/$(incoming().storyId))
                    && incoming().storyAuthorId == get(/databases/$(database)/documents/stories/$(incoming().storyId)).data.authorId
                    && (
                      (
                        !('likesCount' in get(/databases/$(database)/documents/stories/$(incoming().storyId)).data)
                        && getAfter(/databases/$(database)/documents/stories/$(incoming().storyId)).data.likesCount == 1
                      ) ||
                      (
                        ('likesCount' in get(/databases/$(database)/documents/stories/$(incoming().storyId)).data)
                        && getAfter(/databases/$(database)/documents/stories/$(incoming().storyId)).data.likesCount
                           == get(/databases/$(database)/documents/stories/$(incoming().storyId)).data.likesCount + 1
                      )
                    )
                    && incoming().createdAt == request.time;

      allow delete: if isVerified()
                    && isValidId(storyLikeId)
                    && existing().userId == request.auth.uid
                    && exists(/databases/$(database)/documents/stories/$(existing().storyId))
                    && ('likesCount' in get(/databases/$(database)/documents/stories/$(existing().storyId)).data)
                    && getAfter(/databases/$(database)/documents/stories/$(existing().storyId)).data.likesCount
                       == get(/databases/$(database)/documents/stories/$(existing().storyId)).data.likesCount - 1;
    }

    // Polls (/polls/{pollId})
    match /polls/{pollId} {
      allow get: if isValidId(pollId) && (resource == null || existing().visibility == 'public');
      allow list: if (request.query.limit is int && request.query.limit <= 50) || isAdmin();

      allow create: if isNotSuspended()
                    && isValidId(pollId)
                    && isValidPoll(incoming())
                    && incoming().id == pollId
                    && incoming().authorId == request.auth.uid
                    && incoming().totalVotes == 0
                    && incoming().count0 == 0
                    && incoming().count1 == 0
                    && incoming().count2 == 0
                    && incoming().count3 == 0
                    && incoming().count4 == 0
                    && incoming().count5 == 0
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isNotSuspended()
                    && isValidId(pollId)
                    && isValidPoll(incoming())
                    && incoming().id == existing().id
                    && incoming().authorId == existing().authorId
                    && incoming().authorUsername == existing().authorUsername
                    && incoming().authorName == existing().authorName
                    && incoming().authorAvatarUrl == existing().authorAvatarUrl
                    && incoming().question == existing().question
                    && incoming().options == existing().options
                    && incoming().visibility == existing().visibility
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && !exists(/databases/$(database)/documents/pollVotes/$(pollId + '_' + request.auth.uid))
                    && existsAfter(/databases/$(database)/documents/pollVotes/$(pollId + '_' + request.auth.uid))
                    && isSinglePollOptionIncremented(
                      getAfter(/databases/$(database)/documents/pollVotes/$(pollId + '_' + request.auth.uid)).data.optionIndex
                    );

      allow delete: if isVerified()
                    && isValidId(pollId)
                    && (isOwner(existing().authorId) || isAdmin());
    }

    // Poll Votes (/pollVotes/{voteId})
    match /pollVotes/{voteId} {
      allow get: if isSignedIn()
                 && isValidId(voteId)
                 && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isNotSuspended()
                    && isValidId(voteId)
                    && isValidPollVote(incoming())
                    && incoming().id == voteId
                    && incoming().userId == request.auth.uid
                    && voteId == (incoming().pollId + '_' + request.auth.uid)
                    && !exists(/databases/$(database)/documents/pollVotes/$(voteId))
                    && exists(/databases/$(database)/documents/polls/$(incoming().pollId))
                    && incoming().optionIndex < get(/databases/$(database)/documents/polls/$(incoming().pollId)).data.options.size()
                    && getAfter(/databases/$(database)/documents/polls/$(incoming().pollId)).data.totalVotes
                       == get(/databases/$(database)/documents/polls/$(incoming().pollId)).data.totalVotes + 1
                    && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Comments (/comments/{commentId})
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && (resource == null || existing().isPublic == true);
      allow list: if (request.query.limit is int && request.query.limit <= 100) || isAdmin();

      allow create: if isNotSuspended()
                    && isValidId(commentId)
                    && isValidComment(incoming())
                    && incoming().id == commentId
                    && incoming().authorId == request.auth.uid
                    && incoming().isPublic == true
                    && incoming().createdAt == request.time
                    && exists(/databases/$(database)/documents/posts/$(incoming().postId))
                    && getAfter(/databases/$(database)/documents/posts/$(incoming().postId)).data.commentsCount
                       == get(/databases/$(database)/documents/posts/$(incoming().postId)).data.commentsCount + 1;

      allow delete: if isVerified()
                    && isValidId(commentId)
                    && (
                      isOwner(existing().authorId) ||
                      isOwner(existing().postAuthorId) ||
                      isAdmin()
                    );
    }

    // Likes & Reactions (/likes/{likeId})
    match /likes/{likeId} {
      allow get: if isValidId(likeId)
                 && (
                   resource == null
                   || (isSignedIn() && existing().userId == request.auth.uid)
                   || (existing().postId is string && exists(/databases/$(database)/documents/posts/$(existing().postId)))
                 );
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid)
                  || (request.query.limit is int && request.query.limit <= 100)
                  || isAdmin();

      allow create: if isNotSuspended()
                    && isValidId(likeId)
                    && isValidLike(incoming())
                    && incoming().id == likeId
                    && incoming().userId == request.auth.uid
                    && likeId == (incoming().postId + '_' + request.auth.uid)
                    && exists(/databases/$(database)/documents/posts/$(incoming().postId))
                    && getAfter(/databases/$(database)/documents/posts/$(incoming().postId)).data.likesCount
                       == get(/databases/$(database)/documents/posts/$(incoming().postId)).data.likesCount + 1
                    && incoming().createdAt == request.time
                    && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      allow update: if isNotSuspended()
                    && isValidId(likeId)
                    && isValidLike(incoming())
                    && existing().userId == request.auth.uid
                    && incoming().id == existing().id
                    && incoming().postId == existing().postId
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && ('reactionType' in incoming())
                    && isValidReactionType(incoming().reactionType)
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'reactionType', 'userUsername', 'userName', 'userAvatarUrl', 'updatedAt'
                    ])
                    && exists(/databases/$(database)/documents/posts/$(existing().postId))
                    && getAfter(/databases/$(database)/documents/posts/$(existing().postId)).data.likesCount
                       == get(/databases/$(database)/documents/posts/$(existing().postId)).data.likesCount;

      allow delete: if isVerified()
                    && isValidId(likeId)
                    && existing().userId == request.auth.uid
                    && exists(/databases/$(database)/documents/posts/$(existing().postId))
                    && getAfter(/databases/$(database)/documents/posts/$(existing().postId)).data.likesCount
                       == get(/databases/$(database)/documents/posts/$(existing().postId)).data.likesCount - 1;
    }

    // Follows (/follows/{followId})
    match /follows/{followId} {
      allow get: if isSignedIn()
                 && isValidId(followId)
                 && (resource == null || existing().followerId == request.auth.uid || existing().followingId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
                  && (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid || isAdmin());

      allow create: if isNotSuspended()
                    && isValidId(followId)
                    && isValidFollow(incoming())
                    && incoming().id == followId
                    && incoming().followerId == request.auth.uid
                    && followId == (request.auth.uid + '_' + incoming().followingId)
                    && exists(/databases/$(database)/documents/users/$(incoming().followingId))
                    && getAfter(/databases/$(database)/documents/users/$(incoming().followingId)).data.followersCount
                       == get(/databases/$(database)/documents/users/$(incoming().followingId)).data.followersCount + 1
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.followingCount
                       == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.followingCount + 1
                    && incoming().createdAt == request.time;

      allow delete: if isVerified()
                    && isValidId(followId)
                    && existing().followerId == request.auth.uid
                    && exists(/databases/$(database)/documents/users/$(existing().followingId))
                    && getAfter(/databases/$(database)/documents/users/$(existing().followingId)).data.followersCount
                       == get(/databases/$(database)/documents/users/$(existing().followingId)).data.followersCount - 1
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.followingCount
                       == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.followingCount - 1;
    }

    // Saved Posts (/savedPosts/{saveId})
    match /savedPosts/{saveId} {
      allow get: if isSignedIn() && isValidId(saveId) && (resource == null || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isNotSuspended()
                    && isValidId(saveId)
                    && isValidSavedPost(incoming())
                    && incoming().id == saveId
                    && incoming().userId == request.auth.uid
                    && saveId == (request.auth.uid + '_' + incoming().postId)
                    && exists(/databases/$(database)/documents/posts/$(incoming().postId))
                    && incoming().createdAt == request.time;

      allow delete: if isVerified() && isValidId(saveId) && existing().userId == request.auth.uid;
    }

    // Friend Requests (/friendRequests/{requestId})
    match /friendRequests/{requestId} {
      allow get: if isSignedIn()
                 && isValidId(requestId)
                 && (resource == null || request.auth.uid in existing().participantIds || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());

      allow create: if isNotSuspended()
                    && isValidId(requestId)
                    && isValidFriendRequest(incoming())
                    && incoming().id == requestId
                    && incoming().senderId == request.auth.uid
                    && incoming().status == 'pending'
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && exists(/databases/$(database)/documents/users/$(incoming().recipientId));

      allow update: if isNotSuspended()
                    && isValidId(requestId)
                    && isValidFriendRequest(incoming())
                    && request.auth.uid in existing().participantIds
                    && incoming().id == existing().id
                    && incoming().participantIds == existing().participantIds
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      (
                        existing().status == 'pending'
                        && existing().recipientId == request.auth.uid
                        && incoming().senderId == existing().senderId
                        && incoming().recipientId == existing().recipientId
                        && incoming().status in ['accepted', 'declined']
                      ) ||
                      (
                        existing().status == 'declined'
                        && incoming().senderId == request.auth.uid
                        && incoming().status == 'pending'
                      )
                    );

      allow delete: if isVerified()
                    && isValidId(requestId)
                    && (request.auth.uid in existing().participantIds || isAdmin());
    }

    // Notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (resource == null || existing().recipientId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      allow create: if isNotSuspended()
                    && isValidId(notificationId)
                    && isValidNotification(incoming())
                    && incoming().id == notificationId
                    && incoming().actorId == request.auth.uid
                    && incoming().recipientId != request.auth.uid
                    && incoming().isRead == false
                    && incoming().createdAt == request.time
                    && exists(/databases/$(database)/documents/users/$(incoming().recipientId))
                    && (
                      (
                        incoming().type in ['IMPORTANT_APP_ANNOUNCEMENT', 'system']
                        && isAdmin()
                      ) ||
                      (
                        incoming().type == 'NEW_MESSAGE'
                        && 'relatedConversationId' in incoming()
                        && isValidId(incoming().relatedConversationId)
                        && exists(/databases/$(database)/documents/conversations/$(incoming().relatedConversationId))
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(incoming().relatedConversationId)).data.participantIds
                        && incoming().recipientId in get(/databases/$(database)/documents/conversations/$(incoming().relatedConversationId)).data.participantIds
                      ) ||
                      (
                        incoming().type in ['POST_LIKE', 'like']
                        && isValidId(incoming().postId)
                        && (
                          exists(/databases/$(database)/documents/likes/$(incoming().postId + '_' + request.auth.uid)) ||
                          existsAfter(/databases/$(database)/documents/likes/$(incoming().postId + '_' + request.auth.uid))
                        )
                      ) ||
                      (
                        incoming().type in ['NEW_FOLLOWER', 'follow']
                        && (
                          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + incoming().recipientId)) ||
                          existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + incoming().recipientId))
                        )
                      ) ||
                      (
                        incoming().type in ['FRIEND_REQUEST', 'FRIEND_REQUEST_ACCEPTED']
                        && 'relatedRequestId' in incoming()
                        && isValidId(incoming().relatedRequestId)
                        && (
                          exists(/databases/$(database)/documents/friendRequests/$(incoming().relatedRequestId)) ||
                          existsAfter(/databases/$(database)/documents/friendRequests/$(incoming().relatedRequestId))
                        )
                      ) ||
                      (
                        incoming().type in ['POST_COMMENT', 'COMMENT_REPLY', 'USER_MENTION', 'comment', 'mention']
                        && isValidId(incoming().postId)
                        && exists(/databases/$(database)/documents/posts/$(incoming().postId))
                      )
                    );

      allow update: if isVerified()
                    && isValidId(notificationId)
                    && isValidNotification(incoming())
                    && existing().recipientId == request.auth.uid
                    && incoming().recipientId == existing().recipientId
                    && incoming().actorId == existing().actorId
                    && incoming().createdAt == existing().createdAt
                    && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);

      allow delete: if isVerified()
                    && isValidId(notificationId)
                    && (existing().recipientId == request.auth.uid || isAdmin());
    }

    // Conversations (/conversations/{conversationId})
    match /conversations/{conversationId} {
      allow get: if isSignedIn()
                 && isValidId(conversationId)
                 && (resource == null || existing().participantAId == request.auth.uid || existing().participantBId == request.auth.uid);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds);

      allow create: if isNotSuspended()
                    && isValidId(conversationId)
                    && isValidConversation(incoming())
                    && incoming().id == conversationId
                    && request.auth.uid in incoming().participantIds
                    && exists(/databases/$(database)/documents/users/$(incoming().participantAId))
                    && exists(/databases/$(database)/documents/users/$(incoming().participantBId))
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isNotSuspended()
                    && isValidId(conversationId)
                    && isValidConversation(incoming())
                    && (existing().participantAId == request.auth.uid || existing().participantBId == request.auth.uid)
                    && incoming().id == existing().id
                    && incoming().participantIds == existing().participantIds
                    && incoming().participantAId == existing().participantAId
                    && incoming().participantBId == existing().participantBId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      // Action 1: Send message updates preview and unread counters
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'lastMessageText', 'lastMessageSenderId', 'lastMessageAt',
                        'unreadByA', 'unreadByB', 'updatedAt'
                      ]) ||
                      // Action 2: Mark conversation read
                      incoming().diff(existing()).affectedKeys().hasOnly(['unreadByA', 'unreadByB', 'updatedAt']) ||
                      // Action 3: Participant A updates own typing indicator
                      (
                        existing().participantAId == request.auth.uid
                        && incoming().diff(existing()).affectedKeys().hasOnly(['typingAAt', 'updatedAt'])
                        && (incoming().typingAAt == null || incoming().typingAAt == request.time)
                      ) ||
                      // Action 4: Participant B updates own typing indicator
                      (
                        existing().participantBId == request.auth.uid
                        && incoming().diff(existing()).affectedKeys().hasOnly(['typingBAt', 'updatedAt'])
                        && (incoming().typingBAt == null || incoming().typingBAt == request.time)
                      )
                    );

      // Messages subcollection (/conversations/{conversationId}/messages/{messageId})
      match /messages/{messageId} {
        allow get: if isSignedIn()
                   && isValidId(conversationId)
                   && isValidId(messageId)
                   && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;

        allow create: if isNotSuspended()
                      && isValidId(conversationId)
                      && isValidId(messageId)
                      && isValidMessage(incoming())
                      && incoming().id == messageId
                      && incoming().conversationId == conversationId
                      && incoming().senderId == request.auth.uid
                      && incoming().isRead == false
                      && !('readAt' in incoming())
                      && incoming().createdAt == request.time
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                      && incoming().recipientId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow update: if isVerified()
                      && isValidId(conversationId)
                      && isValidId(messageId)
                      && isValidMessage(incoming())
                      && existing().recipientId == request.auth.uid
                      && incoming().id == existing().id
                      && incoming().conversationId == existing().conversationId
                      && incoming().participantIds == existing().participantIds
                      && incoming().senderId == existing().senderId
                      && incoming().recipientId == existing().recipientId
                      && incoming().text == existing().text
                      && incoming().createdAt == existing().createdAt
                      && incoming().isRead == true
                      && (!('readAt' in incoming()) || incoming().readAt == request.time)
                      && (
                        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) ||
                        incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt'])
                      );
      }
    }

    // Moderation Reports (/reports/{reportId})
    match /reports/{reportId} {
      allow get: if isSignedIn()
                 && isValidId(reportId)
                 && (isAdmin() || (resource != null && existing().reporterId == request.auth.uid));
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isNotSuspended()
                    && isValidId(reportId)
                    && isValidReport(incoming())
                    && incoming().id == reportId
                    && incoming().reporterId == request.auth.uid
                    && incoming().status == 'open'
                    && incoming().reviewedBy == ''
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isAdmin()
                    && isValidId(reportId)
                    && isValidReport(incoming())
                    && (existing().status == 'open' || isAdmin())
                    && incoming().id == existing().id
                    && incoming().reporterId == existing().reporterId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // Platform Settings (/platformSettings/config)
    match /platformSettings/config {
      allow get: if true;
      allow create, update: if isAdmin()
                            && isValidPlatformSettings(incoming())
                            && incoming().updatedBy == request.auth.uid
                            && incoming().updatedAt == request.time;
    }

    // Admin Markers (/admins/{userId}) - Server/Console provisioned only
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow write: if false;
    }
  }
}
